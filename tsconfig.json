{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "tests",
    "electron",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.dev.config.ts",
    "playwright.electron.config.ts",
    "eslint.config.js"
  ]
}
