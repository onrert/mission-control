{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "predev": "node scripts/check-ports.mjs",
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:dev": "playwright test -c playwright.dev.config.ts",
    "e2e:chat": "playwright test -c playwright.chat.config.ts",
    "e2e:chat:server": "tsx tests/e2e/helpers/chat-fake-server.ts",
    "e2e:electron": "npm run build && playwright test -c playwright.electron.config.ts",
    "test:e2e": "npm run e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "install-hook": "node scripts/install-hook.mjs",
    "test:chat-live": "vitest run tests/integration/chat-hooks-live.test.ts",
    "electron:fetch": "node ./node_modules/electron/install.js",
    "electron:start": "npm run build && electron .",
    "electron:package": "npm run build && node scripts/package-electron.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.261",
    "@anthropic-ai/sdk": "^0.124.0",
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^4.0.3",
    "react": "^19",
    "react-dom": "^19",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.47",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@electron/packager": "^20.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "concurrently": "^9",
    "electron": "^44.2.0",
    "eslint": "^9",
    "jsdom": "27.0.1",
    "prettier": "^3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5.6",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^5"
  }
}
